# ============================================================
# PolyGlot-StreamBaran - متغيرات البيئة (انسخها إلى .env)
# المؤلف: Baran Avisat  |  Baranavisat@gmail.com
# ============================================================

# === مفاتيح محرك الترجمة (اختر واحداً على الأقل) ===
# Google Gemini API (مجاني) - احصل عليه من: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API (مجاني) - احصل عليه من: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# === Hugging Face (مجاني) - احصل عليه من: https://huggingface.co/settings/tokens ===
HF_TOKEN=your_huggingface_token_here
WHISPER_MODEL=openai/whisper-large-v3

# === Supabase (مجاني) - احصل عليه من: https://supabase.com ===
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here

# === بوت تليجرام (مجاني) - احصل عليه من: @BotFather ===
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# === إعدادات عامة ===
DEFAULT_TARGET_LANG=ar
DEFAULT_WHISPER_MODEL=base
MAX_FILE_SIZE_MB=500
TEMP_DIR=./temp
OUTPUT_DIR=./output
LOG_LEVEL=INFO

# === معلومات المالك لحفظ حقوق الملكية ===
AUTHOR_NAME=Baran Avisat
AUTHOR_EMAIL=Baranavisat@gmail.com
AUTHOR_WHATSAPP=00905313263722
